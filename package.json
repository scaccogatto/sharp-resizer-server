{
  "name": "sharp-resizer-server",
  "version": "2.0.0",
  "description": "Automatic Node.js image resizer server with srcset-ready JSON API",
  "type": "module",
  "main": "index.js",
  "bin": {
    "sharp-resizer-server": "./index.js"
  },
  "files": [
    "index.js",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node index.js",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scaccogatto/sharp-resizer-server.git"
  },
  "keywords": [
    "sharp",
    "resize",
    "node",
    "server",
    "watch",
    "srcset",
    "images"
  ],
  "author": "Marco 'Gatto' Boffo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/scaccogatto/sharp-resizer-server/issues"
  },
  "homepage": "https://github.com/scaccogatto/sharp-resizer-server#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "express": "^5.3.0",
    "p-queue": "^10.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "oxlint": "^1.88.0",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
